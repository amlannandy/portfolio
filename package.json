    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
